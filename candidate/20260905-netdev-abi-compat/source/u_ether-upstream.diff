 #include <linux/etherdevice.h>
 #include <linux/ethtool.h>
 #include <linux/if_vlan.h>
+#include <linux/ktime.h>
 
 #include "u_ether.h"
+#include "sbat6_ncm_telemetry.h"
+
+#define SBAT6_TX_REQ_SLOTS 64
+
+struct sbat6_tx_req_stamp {
+	atomic_long_t key;
+	u64 queued_ns;
+	u64 completed_ns;
+};
+
+static struct sbat6_tx_req_stamp sbat6_tx_req_stamps[SBAT6_TX_REQ_SLOTS];
+
+static unsigned int sbat6_tx_req_hash(const struct usb_request *req)
+{
+	return ((unsigned long)req >> 4) & (SBAT6_TX_REQ_SLOTS - 1);
+}
+
+static struct sbat6_tx_req_stamp *sbat6_tx_req_slot(struct usb_request *req,
+							bool claim)
+{
+	unsigned int i, first = sbat6_tx_req_hash(req);
+
+	for (i = 0; i < SBAT6_TX_REQ_SLOTS; i++) {
+		struct sbat6_tx_req_stamp *slot =
+			&sbat6_tx_req_stamps[(first + i) & (SBAT6_TX_REQ_SLOTS - 1)];
+		unsigned long key = atomic_long_read(&slot->key);
+
+		if (key == (unsigned long)req)
+			return slot;
+		if (!key && claim &&
+		    atomic_long_cmpxchg(&slot->key, 0,
+					(unsigned long)req) == 0)
+			return slot;
+	}
+	return NULL;
+}
+
+static void sbat6_tx_req_queued(struct usb_request *req, u64 queued_ns)
+{
+	struct sbat6_tx_req_stamp *slot = sbat6_tx_req_slot(req, true);
+
+	if (slot)
+		WRITE_ONCE(slot->queued_ns, queued_ns);
+}
+
+static void sbat6_tx_req_unqueued(struct usb_request *req)
+{
+	struct sbat6_tx_req_stamp *slot = sbat6_tx_req_slot(req, false);
+
+	if (slot)
+		WRITE_ONCE(slot->queued_ns, 0);
+}
+
+static void sbat6_tx_req_completed(struct usb_request *req)
+{
+	struct sbat6_tx_req_stamp *slot = sbat6_tx_req_slot(req, false);
+	u64 now, queued, previous;
+	unsigned int latency_us = 0, gap_us = 0;
+
+	if (!slot) {
+		sbat6_ncm_tx_complete(0, 0, false);
+		return;
+	}
+
+	now = ktime_get_ns();
+	queued = READ_ONCE(slot->queued_ns);
+	previous = READ_ONCE(slot->completed_ns);
+	if (queued && now >= queued)
+		latency_us = min_t(u64, (now - queued) / NSEC_PER_USEC,
+				   (u64)UINT_MAX);
+	if (previous && now >= previous)
+		gap_us = min_t(u64, (now - previous) / NSEC_PER_USEC,
+				(u64)UINT_MAX);
+	WRITE_ONCE(slot->completed_ns, now);
+	sbat6_ncm_tx_complete(latency_us, gap_us, queued && now >= queued);
+}
 
 
